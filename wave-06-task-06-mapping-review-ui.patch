+private object FakeProjectionRepository : CatalogStoryProjectionRepository {
+    override fun observe(): Flow<List<CatalogStoryProjection>> = flowOf(
+        listOf(
+            CatalogStoryProjection(
+                storyId = STORY_ID,
+                title = "The Story",
+                contentType = ContentType.WEB_NOVEL,
+                coverUrl = null,

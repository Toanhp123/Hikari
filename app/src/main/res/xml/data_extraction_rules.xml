<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Back up only library metadata and reading progress.
            Session state, cache, and downloads remain device-local.
        -->
        <include
            domain="database"
            path="openstory.db" />
    </cloud-backup>

    <device-transfer>
        <!-- Preserve the user's library and progress on device transfer. -->
        <include
            domain="database"
            path="openstory.db" />
    </device-transfer>
</data-extraction-rules>
